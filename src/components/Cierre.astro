---
import { Image } from 'astro:assets';
import guirnalda from '../assets/adornos/guirnalda.webp';
import Separador from './Separador.astro';
import { evento } from '../config';

const fecha = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires',
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(new Date(evento.fechaISO))
  .replaceAll('/', ' · ');
---

<footer class="cierre">
  <p class="cierre__frase" data-revelar="escritura">{evento.cierre}</p>
  <Separador class="cierre__separador" />
  <p class="cierre__firma caligrafia" data-revelar="escritura" style="--retraso: .4s">{evento.quinceanera}</p>
  <p class="eyebrow cierre__fecha" data-revelar style="--retraso: .9s">XV · {fecha}</p>

  <!-- Guirnalda de rosas y flores de cerezo a lo ancho del final -->
  <Image
    src={guirnalda}
    alt=""
    class="adorno cierre__guirnalda"
    widths={[760, 1140, 1520]}
    sizes="(min-width: 34rem) 34rem, 100vw"
    loading="lazy"
    data-revelar="brote"
  />
</footer>
