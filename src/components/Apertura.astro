---
// Pantalla de bienvenida: un sobre lacrado que se abre al tocar el sello.
// El toque también habilita la música en todos los navegadores.
import { Image } from 'astro:assets';
import corona from '../assets/adornos/corona.webp';
import Destellos from './Destellos.astro';
import Separador from './Separador.astro';
import { evento } from '../config';

interface Props {
  conMusica: boolean;
}
const { conMusica } = Astro.props;

// Borde ondulado del lacre
const lobulos = 16;
const pasos = 192;
const puntos = Array.from({ length: pasos }, (_, i) => {
  const a = (i / pasos) * Math.PI * 2;
  const r = 46 + 2.6 * Math.sin(a * lobulos) + 0.9 * Math.sin(a * 7 + 1);
  return `${(50 + r * Math.cos(a)).toFixed(2)} ${(50 + r * Math.sin(a)).toFixed(2)}`;
});
const bordeLacre = `M${puntos.join(' L')} Z`;
---

<div
  class="apertura"
  id="apertura"
  role="dialog"
  aria-modal="true"
  aria-labelledby="apertura-titulo"
  aria-describedby="apertura-nota"
>
  <div class="apertura__hoja apertura__hoja--izq" aria-hidden="true"></div>
  <div class="apertura__hoja apertura__hoja--der" aria-hidden="true"></div>

  <div class="apertura__contenido">
    <Destellos
      puntos={[
        [12, 14, 14],
        [84, 10, 10],
        [70, 26, 16],
        [20, 38, 9],
        [88, 46, 12],
        [8, 64, 15],
        [78, 72, 10],
        [30, 86, 12],
        [62, 90, 14],
      ]}
    />
    <p class="apertura__aviso">Tenés una invitación especial</p>
    <Image src={corona} alt="" class="apertura__corona" width={210} loading="eager" />
    <p class="apertura__nombre caligrafia" id="apertura-titulo">{evento.quinceanera}</p>
    <p class="apertura__xv">{evento.titulo}</p>
    <Separador class="apertura__separador" />

    <button class="sello" id="abrir" type="button">
      <svg class="sello__cera" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path d={bordeLacre} fill="url(#g-cera)" />
        <circle cx="50" cy="50" r="35" fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="1.2" />
        <circle cx="50" cy="50" r="31.5" fill="none" stroke="url(#g-oro)" stroke-width=".9" />
        <text x="50" y="66" text-anchor="middle" class="sello__inicial" fill="url(#g-oro)">D</text>
      </svg>
      <span class="sello__texto">
        Abrir mi invitación
        <!-- Ícono de mano que toca el botón una y otra vez, para que se entienda dónde tocar -->
        <svg class="manito" viewBox="1 -4.5 22.5 27.5" aria-hidden="true" focusable="false">
          <g class="manito__rayos" fill="none" stroke="#7A1347" stroke-width="1.4" stroke-linecap="round">
            <path d="M8 -0.6V-3"></path>
            <path d="M5.2 0.4 3.4 -1.1"></path>
            <path d="M10.8 0.4 12.6 -1.1"></path>
          </g>
          <path
            d="M6 14V4a2 2 0 0 1 4 0v5a2 2 0 0 1 4 0v1a2 2 0 0 1 4 0v1a2 2 0 0 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15Z"
            fill="#fff"
            stroke="#7A1347"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </button>

    <p class="apertura__nota" id="apertura-nota">
      {conMusica ? 'Tocá para abrirla · con música' : 'Tocá para abrirla'}
    </p>
  </div>
</div>
