---
import '@fontsource/great-vibes/latin-400.css';
import '@fontsource/playball/latin-400.css';
import '@fontsource/cinzel/latin-600.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '../styles/global.css';
import { sitio } from '../config';
import fuenteNombre from '@fontsource/great-vibes/files/great-vibes-latin-400-normal.woff2?url';
import fuenteMayus from '@fontsource/cinzel/files/cinzel-latin-600-normal.woff2?url';

const url = new URL(Astro.url.pathname, Astro.site);
const imagenOG = new URL(sitio.imagenOG, Astro.site).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{sitio.titulo}</title>
    <meta name="description" content={sitio.descripcion} />
    <link rel="canonical" href={url.href} />
    <meta name="theme-color" content={sitio.colorTema} />
    <meta name="color-scheme" content="light only" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Vista previa al compartir el link (WhatsApp, Facebook, Instagram, Telegram) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Mis XV Años · Delfina" />
    <meta property="og:title" content={sitio.titulo} />
    <meta property="og:description" content={sitio.descripcion} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={imagenOG} />
    <meta property="og:image:secure_url" content={imagenOG} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sitio.imagenOGAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={sitio.titulo} />
    <meta name="twitter:description" content={sitio.descripcion} />
    <meta name="twitter:image" content={imagenOG} />
    <meta name="twitter:image:alt" content={sitio.imagenOGAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={fuenteNombre} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteMayus} as="font" type="font/woff2" crossorigin />

    <!-- Activa la pantalla de apertura y las animaciones solo si hay JavaScript -->
    <script is:inline>
      document.documentElement.classList.add('js', 'cerrada');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
